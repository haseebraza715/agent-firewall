{
  "default_decision": "block",
  "budget": {
    "max_calls": 10,
    "max_calls_per_tool": 3,
    "max_identical_calls": 2,
    "max_cost_usd": "0.50"
  },
  "rules": [
    {
      "tool": "database.query",
      "decision": "allow",
      "reason": "single SELECT statements are allowed; database permissions must enforce read-only access",
      "arguments": {
        "query": {
          "operator": "sql",
          "equals": "SELECT"
        }
      }
    },
    {
      "tool": "email.send",
      "decision": "require_approval",
      "reason": "every email send requires recipient and content review"
    },
    {
      "tool": "browser.navigate",
      "decision": "block",
      "reason": "browser navigation is blocked"
    }
  ]
}
