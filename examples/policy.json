{
  "default_decision": "block",
  "audit_arguments": "hash",
  "budget": {
    "max_calls": 10,
    "max_calls_per_tool": 3,
    "max_identical_calls": 2,
    "max_cost_usd": "0.50"
  },
  "rules": [
    {
      "tool": "database.query",
      "decision": "allow",
      "reason": "single SELECT statements are allowed; database permissions must enforce read-only access",
      "arguments": {
        "query": {
          "operator": "sql",
          "equals": "SELECT"
        }
      }
    },
    {
      "tool": "email.send",
      "decision": "require_approval",
      "reason": "outbound email requires a human decision"
    },
    {
      "tool": "quotation.create",
      "decision": "require_approval",
      "reason": "creating a customer quotation has external side effects"
    },
    {
      "tool": "filesystem.read",
      "decision": "allow",
      "reason": "file reads lexically within /workspace are allowed; symlinks are not resolved",
      "arguments": {
        "path": {
          "operator": "path",
          "within": "/workspace"
        }
      }
    },
    {
      "tool": "search.web",
      "decision": "allow",
      "reason": "web search is allowed within runtime budgets"
    },
    {
      "tool": "shell.run",
      "decision": "require_approval",
      "reason": "every shell command requires review; repetition budgets do not establish command safety"
    },
    {
      "tool": "model.generate",
      "decision": "allow",
      "reason": "backend retries are constrained by repetition budgets"
    },
    {
      "tool": "agent.delegate",
      "decision": "allow",
      "reason": "delegation is constrained by repetition budgets"
    },
    {
      "tool": "filesystem.delete",
      "decision": "require_approval",
      "reason": "file deletion is irreversible"
    },
    {
      "tool": "filesystem.write",
      "decision": "require_approval",
      "reason": "file overwrite requires review"
    }
  ]
}
