#!/usr/bin/env expect -f
#
# Drives the terminal demo recorded in docs/demo.cast.
# Run it through scripts/record-demo.sh rather than directly, so the
# recording starts from a clean audit log and a fixed terminal size.

set timeout 60
set send_human {0.028 0.010 1 0.018 0.07}

# asciinema is spawned *inside* expect, wrapping the demo shell, rather than
# expect running under asciinema. That ordering matters: if expect relays the
# shell's output up to a recorder above it, Tcl's buffering coalesces each typed
# command into a single write, the keystroke timing is lost, and the seconds
# spent typing become a frozen screen. Recording from inside means asciinema
# reads the shell's pty directly and sees every character as it is echoed.
proc prompt {} {
    expect -ex "demo $ "
}

proc run {command {pause 1.0}} {
    send -h "$command"
    send "\r"
    prompt
    sleep $pause
}

proc narrate {text {pause 0.7}} {
    send -h "# $text"
    send "\r"
    prompt
    sleep $pause
}

# Nothing expect prints reaches the cast, so keep its relay quiet throughout.
log_user 0

set cast [lindex $argv 0]
set cols [lindex $argv 1]
set rows [lindex $argv 2]
set shell "env 'PS1=demo $ ' 'PS2=> ' BASH_SILENCE_DEPRECATION_WARNING=1\
    bash --noprofile --norc"

spawn asciinema rec $cast --overwrite --quiet \
    --cols $cols --rows $rows \
    --title "Agent Firewall: allow, gate, block" \
    --idle-time-limit 2 \
    --command $shell
prompt

narrate "Every tool call gets a decision before the tool runs."

run "agent-firewall check --tool database.query --format text \\\n  --policy examples/policy.json" 1.3
narrate "Read-only query: allowed. Exit code 0." 0.8

run "agent-firewall check --tool email.send --format text \\\n  --arguments '{\"to\": \"customer@example.com\"}' \\\n  --policy examples/policy.json" 1.3
run "echo \$?" 1.2
narrate "Exit 3: a human decides. The email has not been sent." 0.8

run "agent-firewall check --tool browser.navigate --format text \\\n  --arguments '{\"url\": \"http://169.254.169.254/latest/\"}' \\\n  --policy examples/policy.json" 1.3
run "echo \$?" 1.2
narrate "Exit 4: blocked. No rule allows reaching cloud metadata." 0.8

narrate "Replay 11 scenarios, 10 taken from public bug reports."
run "agent-firewall replay --format text \\\n  --policy examples/policy.json --scenarios examples/complaints.json" 3.2

narrate "Same policy, guarding a real Python function."
send -h "python examples/wrap_tool.py"
send "\r"
expect -ex "teammate@mycompany.com"
sleep 0.9
expect -ex "\[y/N\]"
sleep 1.2
send -h "n"
send "\r"
prompt
sleep 1.4
narrate "Pre-approved recipient went out. The external one did not." 1.0

narrate "Every decision lands in an append-only log."
run "jq -c '{event, decision}' firewall-audit.jsonl" 2.6
narrate "The recipient address is never written to it." 0.8
run "grep -c customer@example.com firewall-audit.jsonl" 2.2

send "exit\r"
expect eof
